                  "pm.test(\"Name is updated\", () => pm.expect(body.name).to.eql(`${pm.collectionVariables.get(\"petName\")}-updated`));",
                  "pm.test(\"Status is updated to sold\", () => pm.expect(body.status).to.eql(\"sold\"));"
