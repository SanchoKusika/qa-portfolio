              "raw": "{\n  \"id\": {{petId}},\n  \"name\": \"{{petName}}-updated\",\n  \"photoUrls\": [\"https://example.com/{{petId}}.jpg\"],\n  \"status\": \"sold\"\n}",
              "options": {
                "raw": {
