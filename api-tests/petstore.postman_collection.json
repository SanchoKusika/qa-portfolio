  "item": [
    {
      "name": "1. Pet CRUD",
      "id": "4bfb84c0-bbf7-5f94-b587-a83580b844b8",
      "item": [
        {
          "name": "Create pet",
          "id": "ab4edd9a-085b-5bcc-a97a-32a2efd06f64",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet"
              ]
            },
            "description": "Создает питомца с уникальным id. id и имя сохраняются в переменные коллекции для следующих запросов.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{petId}},\n  \"category\": { \"id\": 1, \"name\": \"Dogs\" },\n  \"name\": \"{{petName}}\",\n  \"photoUrls\": [\"https://example.com/{{petId}}.jpg\"],\n  \"tags\": [{ \"id\": 1, \"name\": \"qa-portfolio\" }],\n  \"status\": \"available\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const petId = 900000000 + Math.floor(Math.random() * 90000000);",
                  "pm.collectionVariables.set(\"petId\", petId);",
                  "pm.collectionVariables.set(\"petName\", `qa-portfolio-${petId}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type is JSON\", () => pm.response.to.have.header(\"Content-Type\", \"application/json\"));",
                  "pm.test(\"Returned id matches the sent id\", () => pm.expect(body.id).to.eql(pm.collectionVariables.get(\"petId\")));",
                  "pm.test(\"Returned name matches the sent name\", () => pm.expect(body.name).to.eql(pm.collectionVariables.get(\"petName\")));",
                  "pm.test(\"Status is available\", () => pm.expect(body.status).to.eql(\"available\"));",
                  "pm.test(\"Category, photo and tag are saved\", () => {",
                  "  pm.expect(body.category.name).to.eql(\"Dogs\");",
                  "  pm.expect(body.photoUrls).to.have.lengthOf(1);",
                  "  pm.expect(body.tags[0].name).to.eql(\"qa-portfolio\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get pet by id",
          "id": "22217e26-40d2-5cbb-ba48-9ed3fd127f4b",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet/{{petId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                "{{petId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const petSchema = {",
                  "  type: \"object\",",
                  "  required: [\"id\", \"name\", \"photoUrls\", \"status\"],",
                  "  properties: {",
                  "    id: { type: \"integer\" },",
                  "    name: { type: \"string\" },",
                  "    photoUrls: { type: \"array\", items: { type: \"string\" } },",
                  "    tags: { type: \"array\" },",
                  "    status: { type: \"string\", enum: [\"available\", \"pending\", \"sold\"] }",
                  "  }",
                  "};",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body matches the pet schema\", () => pm.response.to.have.jsonSchema(petSchema));",
                  "pm.test(\"Pet data matches the created pet\", () => {",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get(\"petId\"));",
                  "  pm.expect(body.name).to.eql(pm.collectionVariables.get(\"petName\"));",
                  "  pm.expect(body.status).to.eql(\"available\");",
                  "});"
                ]
              }
            }
          ]
        },
