        {
          "name": "Find pets by status sold",
          "id": "4a3b22c4-8642-5f20-8ca6-765ed5b4807c",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet/findByStatus?status=sold",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
                "findByStatus"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "sold"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is a non-empty array\", () => {",
                  "  pm.expect(body).to.be.an(\"array\");",
                  "  pm.expect(body.length).to.be.above(0);",
                  "});",
                  "pm.test(\"Every pet in the result has status sold\", () => {",
                  "  body.forEach(pet => pm.expect(pet.status).to.eql(\"sold\"));",
                  "});",
                  "pm.test(\"Updated pet is in the result\", () => {",
                  "  const ids = body.map(pet => pet.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get(\"petId\"));",
                  "});"
                ]
              }
            }
          ]
        },
